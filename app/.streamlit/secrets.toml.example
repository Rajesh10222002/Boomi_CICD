# Copy this to .streamlit/secrets.toml for local runs and fill in real
# values. NEVER commit the real secrets.toml — it's in .gitignore.
# On Streamlit Community Cloud, paste the same keys into the app's
# "Secrets" panel instead of using this file.

GITHUB_OAUTH_CLIENT_ID = "REPLACE-ME"
GITHUB_OAUTH_CLIENT_SECRET = "REPLACE-ME"
# Must exactly match the OAuth App's "Authorization callback URL".
GITHUB_OAUTH_REDIRECT_URI = "REPLACE-ME"
GITHUB_REPO = "Rajesh10222002/Boomi_CICD"
GITHUB_API_TOKEN = "REPLACE-ME"
ADMIN_USERNAMES = ["REPLACE-WITH-GITHUB-USERNAMES"]
